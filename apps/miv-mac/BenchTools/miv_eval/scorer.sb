(version 1)
(deny default)
(import "system.sb")
(allow file-read* (subpath "/System") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/Library/Apple")
                  (subpath (param "RUNTIME")) (literal (param "SCRIPT")) (literal "/dev/null") (literal "/dev/urandom"))
(allow file-read-metadata)
(allow sysctl-read)
(allow process-exec (literal (param "PYTHON")))
(allow mach-lookup (global-name "com.apple.system.logger"))
