"quant.about.intro_title" = "oQ: oMLX Universal Dynamic Quantization";
"quant.about.mixed_precision.body" = "The quantizer streams tensors from safetensors, measures layer sensitivity, and writes a byte-budgeted mixed-precision checkpoint. Standard oQ focuses on layer-level sensitivity and model-aware protection rules. oQe keeps that same oQ plan and adds imatrix-weighted affine quantization.";
"quant.about.mixed_precision.title" = "oQ and oQe: MLX-native mixed precision";
"quant.about.oqe.fallback" = "If a tensor has no matching imatrix entry, the default behavior is to fall back to standard oQ for that tensor. Enable strict coverage to fail instead.";
"quant.about.oqe.heading" = "What oQe adds";
"quant.about.oqe.how.heading" = "How oQe imatrix works";
"quant.about.oqe.intro" = "oQe uses the same oQ sensitivity planner, then adds an importance-matrix calibration step. This is explicitly borrowed from the llama.cpp imatrix idea: collect activation energy from representative prompts, then use that information so quantization spends less error on the input channels that matter most.";
"quant.about.oqe.step.adapt.body" = "Calibration starts from the requested sample count and can continue up to the adaptive maximum when MoE expert coverage is not sufficient.";
"quant.about.oqe.step.adapt.title" = "Adapt sample count.";
"quant.about.oqe.step.collect.body" = "oQe runs calibration samples through the model and records average input activation squared, E[x^2], for each quantized Linear input channel.";
"quant.about.oqe.step.collect.title" = "Collect activation energy.";
"quant.about.oqe.step.experts.body" = "For MoE SwitchLinear layers, oQe records one importance vector per expert using the router-selected expert indices, so inactive or rarely active experts are visible in the coverage report.";
"quant.about.oqe.step.experts.title" = "Track experts separately.";
"quant.about.oqe.step.weight.body" = "During affine quantization, oQe chooses scale/bias candidates by minimizing sum(importance * (weight - dequantized_weight)^2), not plain unweighted MSE.";
"quant.about.oqe.step.weight.title" = "Weight the quantization error.";
"quant.about.quote.exclusive" = "Quantization should not be exclusive to any particular inference server.";
"quant.about.quote.no_loader" = "No custom loader required.";
"quant.about.quote.works_everywhere" = "oQ produces standard mlx-lm models that work everywhere — oMLX, mlx-lm, LM Studio, and any app that supports MLX safetensors format.";
"quant.about.standard.architecture.body" = "keep MoE routers in fp16, protect shared experts and output-critical tensors, leave vision/audio encoders unquantized, and preserve SSM state tensors.";
"quant.about.standard.architecture.title" = "Architecture rules";
"quant.about.standard.heading" = "What standard oQ does";
"quant.about.standard.layer_sensitivity.body" = "is measured with calibration prompts by comparing quantized-layer output error against the float baseline.";
"quant.about.standard.layer_sensitivity.title" = "Layer sensitivity";
"quant.about.standard.mixed_precision.body" = "allocates higher bits to sensitive layers and protected tensors while keeping the target bits-per-weight budget under a hard cap.";
"quant.about.standard.mixed_precision.title" = "Mixed precision";
"quant.about.subtitle" = "Compare standard oQ with oQe imatrix and how enhanced quantization works.";
