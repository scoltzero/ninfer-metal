+    private func installOrUpdateMicrokernel(
+        providerId: String,
+        displayName: String,
+        client: OMLXClient
+    ) async {
+        guard !busyMicrokernelIds.contains(providerId) else { return }
+        busyMicrokernelIds.insert(providerId)
+        microkernelError = nil
+        microkernelNotice = nil
+        defer { busyMicrokernelIds.remove(providerId) }
