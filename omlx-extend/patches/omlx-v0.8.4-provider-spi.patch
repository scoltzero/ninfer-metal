+    func applyMicrokernelCatalog(_ response: GlobalSettingsDTO.MicrokernelCatalogResponse) {
+        self.microkernelCatalog = response.catalog
+        self.installedMicrokernels = response.installed
+        self.microkernelsRefreshed = response.refreshed ?? false
+        self.microkernelsLastRefreshedAt = response.lastRefreshedAt
