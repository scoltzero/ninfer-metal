+    latest_path = remote_dir / "latest.json"
+    _write_latest(
+        latest_path,
+        provider_id=pid,
+        version="v0.1.0",
+        tar_path=tar_ok,
+        sha256="0" * 64,  # wrong hash!
+    )
+    registry_path = remote_dir / "microkernels.json"
+    registry_path.write_text(
+        json.dumps(
