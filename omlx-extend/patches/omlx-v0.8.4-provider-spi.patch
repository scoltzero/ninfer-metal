+/// Installed microkernel row: left square checkbox (checked = enabled), core metadata,
+/// and right-side Update (lit only after Refresh detects a newer version) + Delete buttons.
+private struct InstalledMicrokernelRow: View {
+    let item: GlobalSettingsDTO.InstalledMicrokernelItem
+    let isBusy: Bool
+    let isLast: Bool
+    let onToggleEnabled: (Bool) -> Void
+    let onUpdate: () -> Void
+    let onRequestDelete: () -> Void
+
+    @Environment(\.omlxTheme) private var theme
+
+    private var modelFamiliesText: String {
+        (item.supportedModelTypes ?? []).joined(separator: " · ")
+    }
+
+    var body: some View {
+        FreeRow(isLast: isLast) {
+            HStack(alignment: .top, spacing: 10) {
+                // Left square checkbox: checked (☑️) = enabled
+                Button {
+                    onToggleEnabled(!item.isEnabled)
+                } label: {
+                    ZStack {
+                        RoundedRectangle(cornerRadius: 4, style: .continuous)
+                            .fill(item.isEnabled ? theme.accent : theme.inputBg)
+                            .frame(width: 16, height: 16)
+                        RoundedRectangle(cornerRadius: 4, style: .continuous)
+                            .strokeBorder(item.isEnabled ? theme.accent : theme.separator, lineWidth: 1)
+                            .frame(width: 16, height: 16)
+                        if item.isEnabled {
+                            Image(systemName: "checkmark")
+                                .font(.system(size: 10, weight: .bold))
+                                .foregroundStyle(.white)
+                        }
+                    }
+                    .frame(width: 20, height: 20)
+                    .contentShape(Rectangle())
+                }
+                .buttonStyle(.plain)
+                .disabled(isBusy)
+                .opacity(isBusy ? 0.5 : 1.0)
+                .padding(.top, 1)
+                .accessibilityLabel(item.resolvedDisplayName)
+                .accessibilityValue(item.isEnabled ? "Checked" : "Unchecked")
+                .help(item.isEnabled
+                      ? String(localized: "integrations.microkernels.checkbox.enabled_help",
+                               defaultValue: "Enabled — included in auto-routing and model engine selection",
+                               comment: "Tooltip for checked microkernel checkbox")
+                      : String(localized: "integrations.microkernels.checkbox.disabled_help",
+                               defaultValue: "Disabled — skipped by auto-routing and hidden from model selection",
+                               comment: "Tooltip for unchecked microkernel checkbox"))
+
+                // Center core identity, supported models, and install path
+                VStack(alignment: .leading, spacing: 5) {
+                    HStack(alignment: .center, spacing: 6) {
+                        if item.isPathA {
+                            Image("IntegrationNinferMetal")
+                                .resizable()
+                                .interpolation(.high)
+                                .scaledToFit()
+                                .frame(width: 22, height: 22)
+                                .opacity(item.isEnabled ? 1.0 : 0.45)
+                        }
+                        Text(item.resolvedDisplayName)
+                            .font(.omlxText(DesignTokens.FontSize.body, weight: .semibold))
+                            .foregroundStyle(item.isEnabled ? theme.text : theme.textSecondary)
+                            .lineLimit(1)
+                            .truncationMode(.tail)
+
+                        if item.isUpdateReady, let cur = item.version, let rem = item.remoteVersion {
+                            MicrokernelTagPill(label: "\(cur) → \(rem)", tone: .accent, mono: true)
+                        } else if let ver = item.version, !ver.isEmpty {
+                            MicrokernelTagPill(label: ver, tone: .neutral, mono: true)
+                        }
+
+                        MicrokernelTagPill(
+                            label: item.resolvedTier,
+                            tone: item.isPathA ? .accent : .indigo
+                        )
+
+                        if !item.isEnabled {
+                            MicrokernelTagPill(
+                                label: String(localized: "integrations.microkernels.disabled_badge",
+                                              defaultValue: "Disabled",
+                                              comment: "Compact pill shown when a microkernel checkbox is unchecked"),
+                                tone: .neutral
+                            )
+                        }
+                        if !item.isManaged {
+                            MicrokernelTagPill(
+                                label: String(localized: "integrations.microkernels.external_badge",
+                                              defaultValue: "Local Path",
+                                              comment: "Compact pill shown when a microkernel comes from a local/external path outside Providers/"),
+                                tone: .neutral
+                            )
+                        }
+                    }
+
+                    if !modelFamiliesText.isEmpty {
+                        Text(modelFamiliesText)
+                            .font(.omlxMono(DesignTokens.FontSize.caption))
+                            .foregroundStyle(theme.textSecondary)
+                            .lineLimit(2)
+                            .fixedSize(horizontal: false, vertical: true)
+                    }
+
+                    if let path = item.resolvedPath {
+                        HStack(spacing: 6) {
+                            CodeChip(value: path)
+                            Text(item.providerId)
+                                .font(.omlxMono(DesignTokens.FontSize.caption))
+                                .foregroundStyle(theme.textTertiary)
+                                .lineLimit(1)
+                        }
+                    }
+
+                    if item.pendingReload == true {
+                        let ver = item.pendingReloadVersion ?? item.version ?? ""
+                        Text(String(localized: "integrations.microkernels.pending_reload_hint",
+                                    defaultValue: "Hot-updated to \(ver) — reload active model(s) to switch.",
+                                    comment: "Inline hint on a microkernel row after hot-updating while models are running"))
+                            .font(.omlxText(DesignTokens.FontSize.caption, weight: .medium))
+                            .foregroundStyle(theme.amberDot)
+                    }
+                }
+                .frame(maxWidth: .infinity, alignment: .leading)
+
+                // Right actions: Update (lit only after refresh confirms newer version) + Delete
+                HStack(spacing: 6) {
+                    Button(action: onUpdate) {
+                        HStack(spacing: 4) {
+                            if isBusy {
+                                ProgressView().controlSize(.mini)
+                            }
+                            Text(String(localized: "integrations.microkernels.update",
+                                        defaultValue: "Update",
+                                        comment: "Button label to hot-update an installed microkernel core"))
+                        }
+                    }
+                    .buttonStyle(.omlx(item.isUpdateReady ? .primary : .normal, size: .small))
+                    .disabled(!item.isUpdateReady || isBusy)
+                    .help(item.isUpdateReady
+                          ? String(localized: "integrations.microkernels.update.ready_help",
+                                   defaultValue: "Hot-update to \(item.remoteVersion ?? "latest")",
+                                   comment: "Tooltip when Update button is active")
+                          : String(localized: "integrations.microkernels.update.idle_help",
+                                   defaultValue: "Click Refresh to check for newer releases",
+                                   comment: "Tooltip when Update button is disabled"))
+
+                    Button(action: onRequestDelete) {
+                        Text(String(localized: "integrations.microkernels.delete",
+                                    defaultValue: "Delete",
+                                    comment: "Destructive delete button for an installed microkernel"))
+                            .foregroundStyle(item.isDeletable && !isBusy ? theme.redDot : theme.textTertiary)
+                    }
+                    .buttonStyle(.omlx(.normal, size: .small))
+                    .disabled(!item.isDeletable || isBusy)
+                    .help(item.isDeletable
+                          ? String(localized: "integrations.microkernels.delete.help",
+                                   defaultValue: "Delete this installed microkernel",
+                                   comment: "Tooltip for enabled Delete button")
+                          : String(localized: "integrations.microkernels.delete.unmanaged_help",
+                                   defaultValue: "External / local build path cannot be deleted here — uncheck to disable instead",
+                                   comment: "Tooltip when Delete button is disabled for an unmanaged path"))
+                }
+                .padding(.top, 2)
+            }
+        }
+    }
+}
