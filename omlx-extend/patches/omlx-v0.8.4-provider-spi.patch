+        spec_search=str(opts["spec_search"]) if opts.get("spec_search") is not None else None,
+        draft_tokens=draft_tokens,
+        concurrency_source=concurrency_source,
+        lora_adapter=lora_adapter,
+        lora_mode=lora_mode,
