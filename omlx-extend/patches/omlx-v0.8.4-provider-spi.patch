+    func refreshMicrokernels(client: OMLXClient) async {
+        guard !refreshingMicrokernels else { return }
+        refreshingMicrokernels = true
+        microkernelError = nil
+        microkernelNotice = nil
+        defer { refreshingMicrokernels = false }
+        do {
+            let resp = try await client.refreshMicrokernels()
+            applyMicrokernelCatalog(resp)
+            let updates = resp.installed.filter(\.isUpdateReady).count
+            if updates > 0 {
+                microkernelNotice = String(
+                    localized: "integrations.microkernels.refresh_updates_found",
+                    defaultValue: "Registry refreshed — \(updates) update(s) available.",
+                    comment: "Status notice after refreshing microkernels when updates are available"
+                )
+            } else if resp.registryError == nil {
+                microkernelNotice = String(
+                    localized: "integrations.microkernels.refresh_up_to_date",
+                    defaultValue: "Registry refreshed — all installed cores are up to date.",
+                    comment: "Status notice after refreshing microkernels when no updates are available"
+                )
+            }
+        } catch {
+            microkernelError = error.omlxDescription
+        }
