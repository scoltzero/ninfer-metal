+                    max(8 * 1024 * 1024, eng._weights_bytes() + 4 * 1024 * 1024),
+                )
+                assert eng.process_memory_bytes() == expected_sidecar_mem
+                assert enforcer._current_usage_bytes() == 32 * 1024 * 1024 + expected_sidecar_mem
