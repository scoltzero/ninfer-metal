+@dataclass(frozen=True)
+class ProbeResult:
+    """Fast O(1) filesystem probe result for automatic model routing."""
+
+    adapted: bool
+    artifact_path: Path | None = None
+    draft_path: Path | None = None
+    reason: str = ""
