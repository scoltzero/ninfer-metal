+                monkeypatch.setattr("omlx.process_memory_enforcer.mx.get_cache_memory", lambda: 0)
+                monkeypatch.setattr("omlx.process_memory_enforcer.unreleased_graphics_bytes", lambda *_a, **_kw: 0)
+                expected_sidecar_mem = max(
