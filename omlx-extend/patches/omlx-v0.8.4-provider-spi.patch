+    def to_rpc_dict(self) -> dict[str, Any]:
+        """Serialize resolved M5 options for the sidecar `load` RPC payload."""
+        eff_ane_mode = self.prefill_ane_mode
+        if eff_ane_mode == "off" and self.prefill_ane_offload:
+            eff_ane_mode = "auto"
+        payload: dict[str, Any] = {
