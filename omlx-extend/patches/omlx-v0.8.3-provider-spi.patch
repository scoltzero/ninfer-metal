+        if (explicit_opts is not None or model_toml is not None or shared_toml is not None)
+        else (opts,)
+    )
+    for layer in layers:
+        if not layer:
+            continue
+        if layer.get("prefix_cache_bytes") is not None:
+            return max(0, int(layer["prefix_cache_bytes"]))
