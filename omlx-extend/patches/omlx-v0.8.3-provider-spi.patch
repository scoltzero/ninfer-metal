+                                label: String(localized: "integrations.microkernels.external_badge",
+                                              defaultValue: "Local Path",
+                                              comment: "Compact pill shown when a microkernel comes from a local/external path outside Providers/"),
+                                tone: .neutral
+                            )
+                        }
+                    }
+
+                    if !modelFamiliesText.isEmpty {
