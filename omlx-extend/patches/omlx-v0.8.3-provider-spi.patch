+def _sha256_file(path: Path) -> str | None:
+    try:
+        return hashlib.sha256(path.read_bytes()).hexdigest()
+    except OSError:
+        return None
+
+
+def _normalize_slug(text: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "", text.lower())
