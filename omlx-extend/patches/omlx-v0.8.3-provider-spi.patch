+/// Installed microkernel row: left square checkbox (checked = enabled), core metadata,
+/// and right-side Update (lit only after Refresh detects a newer version) + Delete buttons.
+private struct InstalledMicrokernelRow: View {
+    let item: GlobalSettingsDTO.InstalledMicrokernelItem
+    let isBusy: Bool
+    let isLast: Bool
+    let onToggleEnabled: (Bool) -> Void
+    let onUpdate: () -> Void
+    let onRequestDelete: () -> Void
+
+    @Environment(\.omlxTheme) private var theme
+
+    private var modelFamiliesText: String {
+        (item.supportedModelTypes ?? []).joined(separator: " · ")
+    }
+
+    var body: some View {
+        FreeRow(isLast: isLast) {
+            HStack(alignment: .top, spacing: 10) {
+                // Left square checkbox: checked (☑️) = enabled
+                Button {
+                    onToggleEnabled(!item.isEnabled)
+                } label: {
+                    ZStack {
+                        RoundedRectangle(cornerRadius: 4, style: .continuous)
+                            .fill(item.isEnabled ? theme.accent : theme.inputBg)
+                            .frame(width: 16, height: 16)
+                        RoundedRectangle(cornerRadius: 4, style: .continuous)
+                            .strokeBorder(item.isEnabled ? theme.accent : theme.separator, lineWidth: 1)
+                            .frame(width: 16, height: 16)
+                        if item.isEnabled {
+                            Image(systemName: "checkmark")
+                                .font(.system(size: 10, weight: .bold))
+                                .foregroundStyle(.white)
+                        }
+                    }
+                    .frame(width: 20, height: 20)
+                    .contentShape(Rectangle())
+                }
+                .buttonStyle(.plain)
+                .disabled(isBusy)
+                .opacity(isBusy ? 0.5 : 1.0)
+                .padding(.top, 1)
+                .accessibilityLabel(item.resolvedDisplayName)
+                .accessibilityValue(item.isEnabled ? "Checked" : "Unchecked")
+                .help(item.isEnabled
+                      ? String(localized: "integrations.microkernels.checkbox.enabled_help",
+                               defaultValue: "Enabled — included in auto-routing and model engine selection",
+                               comment: "Tooltip for checked microkernel checkbox")
+                      : String(localized: "integrations.microkernels.checkbox.disabled_help",
+                               defaultValue: "Disabled — skipped by auto-routing and hidden from model selection",
+                               comment: "Tooltip for unchecked microkernel checkbox"))
+
+                // Center core identity, supported models, and install path
