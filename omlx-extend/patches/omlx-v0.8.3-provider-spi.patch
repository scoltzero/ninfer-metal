+
+    def _positive_int(d: dict[str, Any] | None, key: str) -> int | None:
+        if d is None or d.get(key) is None:
+            return None
+        val = int(d[key])
+        return val if val > 0 else None
+
+    explicit_dt = (
+        _positive_int(explicit_opts, "draft_tokens")
