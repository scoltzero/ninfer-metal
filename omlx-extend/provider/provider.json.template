    "incoai/Qwen3.8-9B-DFlash2",
    "z-lab/Qwen3.5-4B-DFlash2",
    "incoai/Qwen3.5-4B-DFlash2",
    "z-lab/Qwen3.6-4B-DFlash2",
    "incoai/Qwen3.6-4B-DFlash2",
    "z-lab/Qwen3.8-4B-DFlash2",
    "incoai/Qwen3.8-4B-DFlash2",
    "z-lab/Qwen3.5-2B-DFlash2",
