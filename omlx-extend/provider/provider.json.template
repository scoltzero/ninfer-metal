{
  "schema": "ninfer-metal-provider-v1",
  "provider_id": "io.ninfer.metal",
  "legacy_provider_ids": [
    "com.omlx.mseries"
  ],
  "engine_id": "m5rt",
  "display_name": "miv Core Backend (ninfer-metal)",
  "display_version": "${DISPLAY_VERSION}",
  "codename": "${CODENAME}",
  "semver": "${SEMVER}",
  "core_abi": 1,
  "protocol_version": 2,
  "supported_protocols": [
    1,
    2
  ],
  "engine_contract_version": 1,
  "min_omlx_extend_version": "0.8.0-extend",
  "min_macos_version": "27.0",
  "arch": "arm64",
  "binary": "bin/mseries_backendd",
  "entrypoint": "bin/mseries_backendd",
  "metallib_dir": "metallib",
  "calibrations_dir": "calibrations",
  "supported_topologies": [
    "qwen35_hybrid_dense_v1",
    "qwen36_hybrid_moe256_k8_shared_v1"
  ],
  "supported_model_types": [
    "qwen3_5",
    "qwen3_5_moe",
    "qwen3_6",
    "qwen3_6_moe",
    "qwen3_8",
    "qwen3_8_moe"
  ],
  "supported_draft_architectures": [
    "DFlash2DraftModel"
  ],
  "supported_dflash2_models": [
    "z-lab/Qwen3.8-27B-DFlash2",
    "incoai/Qwen3.8-27B-DFlash2",
    "z-lab/Qwen3.6-27B-DFlash2",
    "incoai/Qwen3.6-27B-DFlash2",
    "z-lab/Qwen3.5-27B-DFlash2",
    "incoai/Qwen3.5-27B-DFlash2",
    "z-lab/Qwen3.6-35B-A3B-DFlash2",
    "incoai/Qwen3.6-35B-A3B-DFlash2",
    "z-lab/Qwen3.5-35B-A3B-DFlash2",
    "incoai/Qwen3.5-35B-A3B-DFlash2",
    "z-lab/Qwen3.8-35B-A3B-DFlash2",
    "incoai/Qwen3.8-35B-A3B-DFlash2",
    "incoai/Ornith-1.5-122B-DFlash2",
    "z-lab/Ornith-1.5-122B-DFlash2",
    "z-lab/Qwen3.5-122B-A10B-DFlash2",
    "incoai/Qwen3.5-122B-A10B-DFlash2",
    "z-lab/Qwen3.6-122B-A10B-DFlash2",
    "incoai/Qwen3.6-122B-A10B-DFlash2",
    "z-lab/Qwen3.8-122B-A10B-DFlash2",
    "incoai/Qwen3.8-122B-A10B-DFlash2",
    "z-lab/Qwen3.5-9B-DFlash2",
    "incoai/Qwen3.5-9B-DFlash2",
    "z-lab/Qwen3.6-9B-DFlash2",
    "incoai/Qwen3.6-9B-DFlash2",
    "z-lab/Qwen3.8-9B-DFlash2",
    "incoai/Qwen3.8-9B-DFlash2",
    "z-lab/Qwen3.5-4B-DFlash2",
    "incoai/Qwen3.5-4B-DFlash2",
    "z-lab/Qwen3.6-4B-DFlash2",
    "incoai/Qwen3.6-4B-DFlash2",
    "z-lab/Qwen3.8-4B-DFlash2",
    "incoai/Qwen3.8-4B-DFlash2",
    "z-lab/Qwen3.5-2B-DFlash2",
    "incoai/Qwen3.5-2B-DFlash2",
    "z-lab/Qwen3.6-2B-DFlash2",
    "incoai/Qwen3.6-2B-DFlash2",
    "z-lab/Qwen3.8-2B-DFlash2",
    "incoai/Qwen3.8-2B-DFlash2",
    "z-lab/Qwen3.5-0.8B-DFlash2",
    "incoai/Qwen3.5-0.8B-DFlash2",
    "z-lab/Qwen3.6-0.8B-DFlash2",
    "incoai/Qwen3.6-0.8B-DFlash2",
    "z-lab/Qwen3.8-0.8B-DFlash2",
    "incoai/Qwen3.8-0.8B-DFlash2"
  ],
  "artifact_extensions": [
    ".miv",
    ".omlxm5"
  ],
  "converter": {
    "entrypoint": "tools/m5_artifact.py",
    "subcommand": "convert",
    "output_filename": "model.miv",
    "artifact_extension": ".miv",
    "default_args": [
      "--nax-pretile"
    ],
    "supported_quant_modes": [
      "affine",
      "mxfp4",
      "mxfp4-pack-quantized"
    ]
  },
  "capabilities": [
    "ar",
    "mtp",
    "dflash2",
    "lora",
    "reload_lora",
    "kv_affine4_g128",
    "rolling_prefix_cache",
    "trim_cache",
    "memory_budget_bytes",
    "set_scheduler_hint",
    "cancel",
    "stats",
    "capacity",
    "thinking_budget",
    "sampling_penalties",
    "subscribe_events"
  ],
  "kv_formats": [
    "bf16",
    "affine4_g128"
  ],
  "speculative_limits": {
    "mtp": 4,
    "dflash2": 7
  },
  "load_defaults": {
    "max_concurrency": 4,
    "max_context": 262144,
    "kv_dtype": "affine4_g128",
    "sampling_contract": "position_coupled_v1",
    "draft_tokens": 0,
    "prefill_linear_mode": "bf16",
    "prefill_attention_mode": "exact_nax",
    "prefill_sparse_minference": false,
    "prefill_cache_blend": false,
    "prefill_ane_mode": "off",
    "prefill_ane_offload": false
  },
  "supported_standard_settings": [
    "max_context_window",
    "mtp_enabled",
    "mtp_adaptive_max_depth",
    "mtp_fixed_depth",
    "dflash_enabled",
    "dflash_draft_model",
    "dflash_block_size",
    "turboquant_kv_enabled",
    "turboquant_kv_scheme",
    "lora_adapter"
  ],
  "options_schema": [
    {
      "key": "max_concurrency",
      "label": "Concurrency (B/C)",
      "type": "int",
      "min": 1,
      "max": 8,
      "default": 4,
      "reload_required": true
    },
    {
      "key": "max_context",
      "label": "Max Context Window",
      "type": "int",
      "min": 1024,
      "max": 1048576,
      "default": 262144,
      "description": "Maximum sequence context length in tokens (supports 256K = 262144 and above when model permits).",
      "reload_required": true
    },
    {
      "key": "rolling_prefix_cache",
      "label": "Rolling Prefix Cache",
      "type": "bool",
      "default": true,
      "reload_required": true
    },
    {
      "key": "prefix_cache_gb",
      "label": "Prefix Cache Budget (GiB)",
      "type": "bytes_gb",
      "min": 0,
      "max": 128,
      "default": 4,
      "reload_required": true
    },
    {
      "key": "prefill_linear_mode",
      "label": "Prefill Linear Mode",
      "type": "enum",
      "options": [
        "bf16",
        "w4a8",
        "w4a4"
      ],
      "option_labels": {
        "bf16": "BF16 (Exact)",
        "w4a8": "A8 (Universal W4A8)",
        "w4a4": "A4 (Native W4A4, MXFP4 Only)"
      },
      "description": "Prefill linear GEMM precision: BF16 exact, W4A8 universal (MXFP4 & oQ4e), or native W4A4 (MXFP4 models only; auto-falls back to W4A8 on non-MXFP4). Decode remains exact W4A16.",
      "default": "bf16",
      "reload_required": true
    },
    {
      "key": "prefill_attention_mode",
      "label": "Sage2 Attention",
      "type": "enum",
      "options": [
        "exact_nax",
        "sage2"
      ],
      "option_labels": {
        "exact_nax": "Exact NAX",
        "sage2": "Sage2 (INT8 QK + FP16 PV)"
      },
      "description": "Low-bit INT8 QK prefill attention (dense full-receptive-field Sage2 by default; optionally enable MInference sparse below).",
      "default": "exact_nax",
      "reload_required": true
    },
    {
      "key": "prefill_sparse_minference",
      "label": "MInference Sparse",
      "type": "bool",
      "description": "Optional dynamic block-sparse KV skipping under Sage2 (off = dense full-receptive-field Sage2; on = dynamic block-sparse Sage2 + MInference).",
      "default": false,
      "reload_required": true
    },
    {
      "key": "prefill_cache_blend",
      "label": "CacheBlend Reuse",
      "type": "bool",
      "description": "Non-contiguous RAG chunk KV+GDN reuse (4.3x-4.5x warmer TTFT). Increase Prefix Cache Budget (e.g. 16-32 GiB) for long docs.",
      "default": false,
      "reload_required": true
    },
    {
      "key": "prefill_ane_mode",
      "label": "ANE Collaboration Mode",
      "type": "enum",
      "options": [
        "off",
        "auto",
        "compact_int8",
        "ultra_fp16_swiglu"
      ],
      "option_labels": {
        "off": "Off (GPU Only)",
        "auto": "Auto",
        "compact_int8": "Compact INT8",
        "ultra_fp16_swiglu": "Ultra FP16 SwiGLU"
      },
      "description": "Orthogonal Dual-ANE co-execution mode (off, auto hardware crossover, balanced compact INT8, or Ultra direct FP16 SwiGLU). Dense-only and skips GDN recurrence.",
      "default": "off",
      "reload_required": true
    },
    {
      "key": "lora_mode",
      "label": "LoRA Mode",
      "type": "enum",
      "options": [
        "merge",
        "bypass"
      ],
      "option_labels": {
        "merge": "Merge (Load-Time UMA Fusion)",
        "bypass": "Bypass (Runtime BF16 Low-Rank)"
      },
      "description": "Merge fuses LoRA into 8-bit NAX tiles at load time with zero runtime overhead; Bypass injects low-rank BF16 projections at runtime with fast hot-swap.",
      "default": "merge",
      "reload_required": true
    },
    {
      "key": "speculative_backend",
      "label": "Speculative Backend",
      "type": "enum",
      "options": [
        "auto",
        "none",
        "mtp",
        "dflash2"
      ],
      "default": "auto",
      "reload_required": true
    },
    {
      "key": "sampling_contract",
      "label": "Sampling Contract",
      "type": "enum",
      "options": [
        "position_coupled_v1",
        "legacy_rejection_v1"
      ],
      "option_labels": {
        "position_coupled_v1": "Position Coupled v1 (GPU Fast Path)",
        "legacy_rejection_v1": "Legacy Rejection v1 (Debug / Slow)"
      },
      "description": "Position Coupled v1 keeps speculative verification on GPU with zero host logit readback. Legacy Rejection v1 is for debug parity only and substantially slower.",
      "default": "position_coupled_v1",
      "reload_required": true
    },
    {
      "key": "artifact_path",
      "label": "Artifact Path",
      "type": "string",
      "default": "",
      "reload_required": true
    },
    {
      "key": "draft_artifact_path",
      "label": "Draft Artifact Path",
      "type": "string",
      "default": "",
      "reload_required": true
    }
  ],
  "built_at_utc": "${BUILT_AT_UTC}",
  "git_commit": "${GIT_COMMIT}"
}
